{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@kkk/richtext": [
        "./ktr/richtext/index.ts"
      ]
    },
    "outDir": "./lib",
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": false,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "trss-yunzai"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "lib",
    "node_modules",
    "tests"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
